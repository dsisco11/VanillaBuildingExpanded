{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (dotnet)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "-c",
                "Debug",
                "${workspaceFolder}/VanillaBuildingExpanded/VanillaBuildingExpanded.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "panel": "shared",
                "reveal": "never",
                "focus": false,
                "close": false,
                "showReuseMessage": false
            },
        },
        {
            "label": "Package",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/CakeBuild/CakeBuild.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "panel": "shared",
                "reveal": "never",
                "focus": false,
                "close": false,
                "showReuseMessage": false
            },
        },
        {
            "label": "Build (Cake)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "-c",
                "Debug",
                "${workspaceFolder}/CakeBuild/CakeBuild.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "panel": "shared",
                "reveal": "never",
                "focus": false,
                "close": false,
                "showReuseMessage": false
            },
        },
        {
            "label": "Test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "-c",
                "Debug",
                "${workspaceFolder}/VanillaBuildingExpanded.Tests/VanillaBuildingExpanded.Tests.csproj",
                "-v",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "panel": "new",
                "reveal": "never",
                "focus": false,
                "close": true,
                "showReuseMessage": false
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Install development mod",
            "type": "shell",
            "group": "build",
            "dependsOn": "Package",
            "dependsOrder": "sequence",
            "command": "& '${workspaceFolder}/tools/ManageDevelopmentMod.ps1' -Action Install"
        },
        {
            "label": "Uninstall development mod",
            "type": "shell",
            "group": "build",
            "command": "& '${workspaceFolder}/tools/ManageDevelopmentMod.ps1' -Action Uninstall"
        }
    ]
}